{
  "name": "ydh-chronicle",
  "version": "0.28.0",
  "private": true,
  "description": "YDH Chronicle mobile MMORPG web app with Android APK packaging support.",
  "type": "module",
  "scripts": {
    "mmo:server": "node server/mobile-mmo-server.js",
    "mmo:start": "node server/mobile-mmo-server.js",
    "android:generate": "node tools/create-android-project.mjs",
    "android:branding": "node tools/apply-android-branding.mjs",
    "android:webview-debug-apk": "node tools/create-android-project.mjs && gradle app:assembleDebug",
    "android:webview-release-apk": "node tools/create-android-project.mjs && gradle app:assembleRelease",
    "cap:init": "cap init YDHChronicle com.ydhappy.ydhchronicle --web-dir .",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync android",
    "android:open": "cap open android",
    "android:debug-apk": "cd android && ./gradlew assembleDebug",
    "android:release-apk": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "latest",
    "@capacitor/core": "latest",
    "ws": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "latest"
  }
}
